{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag-studio-apps.github.io/meshterm-vulnfeed/manifest.schema.json",
  "title": "meshTerm vulnfeed manifest (v1/manifest.json, schema 1)",
  "description": "Documentation only: builder/build.py check_manifest() is authoritative. The only signed file; every other file is verified by the sha256 recorded here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "serial", "generated", "sources", "releases", "curated"],
  "properties": {
    "schema": {"const": 1},
    "serial": {"type": "integer", "minimum": 1, "description": "The number in the trusted comment's version= token."},
    "version": {"type": "integer", "minimum": 1, "description": "Always equal to serial, so SignedArtifactVerifier.jsonVersion(of:) reads it."},
    "generated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "sources": {
      "type": "object",
      "description": "Empty with no releases; otherwise exactly osv (newest OSV `modified` per ecosystem zip), archive (each suite's Release Date) and baseline (each release's release-day date).",
      "additionalProperties": false,
      "properties": {
        "osv": {"type": "object", "propertyNames": {"enum": ["Debian", "Ubuntu", "Alpine", "AlmaLinux", "Red Hat"]},
                "additionalProperties": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}},
        "archive": {"type": "object", "propertyNames": {"pattern": "^[a-z]+(-updates|-security)?$"},
                    "additionalProperties": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}},
        "baseline": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}
      }
    },
    "releases": {
      "type": "object",
      "description": "Release key -> its content-addressed file (body: {release, format, keyedBy, pkgs, kernel}, plan 4.1). Keys are the builder/osvfeed.py RELEASES allowlist.",
      "propertyNames": {"enum": ["ubuntu-20.04", "ubuntu-22.04", "ubuntu-24.04", "ubuntu-26.04", "ubuntu-26.10",
                                 "ubuntu-20.04-esm", "ubuntu-22.04-esm", "ubuntu-24.04-esm", "ubuntu-26.04-esm",
                                 "debian-11", "debian-12", "debian-13",
                                 "alpine-3.20", "alpine-3.21", "alpine-3.22", "alpine-3.23", "alpine-3.24",
                                 "alma-8", "alma-9", "alma-10", "rhel-8", "rhel-9", "rhel-10"]},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "file", "sha256", "bytes", "rows"],
        "properties": {
          "format": {"enum": ["dpkg", "apk", "rpm"]},
          "file": {"type": "string", "pattern": "^r/[a-z0-9][a-z0-9.-]{0,40}-[0-9a-f]{16}\\.json$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 614400},
          "rows": {"type": "integer", "minimum": 0}
        }
      }
    },
    "curated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {"type": "string", "pattern": "^curated-[0-9a-f]{16}\\.json$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
